@model ProductosYCategorias.Models.Category

@{
    ViewData["Title"] = "Eliminar categoría";
    var productCount = Model.Products.Count;
    var canDelete = productCount == 0;
}

<nav aria-label="migas de pan" class="mb-2">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Categorías</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></li>
        <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
    </ol>
</nav>

<h1 class="mb-3">Eliminar categoría</h1>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card border-danger">
            <div class="card-body">
                <h2 class="h5">¿Seguro que quieres eliminar «@Model.Name»?</h2>
                <p class="text-muted">Esta acción no se puede deshacer.</p>

                <dl class="row mb-0">
                    <dt class="col-sm-3">Nombre</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Descripción</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

                    <dt class="col-sm-3">Productos</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(canDelete ? "bg-secondary" : "bg-warning text-dark")">@productCount</span>
                    </dd>
                </dl>
            </div>

            <div class="card-footer bg-white">
                @if (canDelete)
                {
                    <form asp-action="Delete" class="d-flex flex-wrap gap-2">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        No se puede eliminar esta categoría porque tiene @productCount producto(s) asociado(s).
                        Mueve o elimina esos productos primero.
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            Ver productos
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
