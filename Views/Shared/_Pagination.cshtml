@model ProductosYCategorias.Models.PageInfo

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var routeValues = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var item in Context.Request.Query)
    {
        if (string.Equals(item.Key, "page", StringComparison.OrdinalIgnoreCase) ||
            string.IsNullOrEmpty(item.Value))
        {
            continue;
        }

        routeValues[item.Key] = item.Value.ToString();
    }

    if (!string.IsNullOrEmpty(currentController))
    {
        routeValues["controller"] = currentController;
    }

    string PageUrl(int page)
    {
        var values = new Dictionary<string, string>(routeValues, StringComparer.OrdinalIgnoreCase)
        {
            ["page"] = page.ToString()
        };

        return Url.Action(currentAction, values) ?? "#";
    }

    var windowStart = Math.Max(1, Model.CurrentPage - 2);
    var windowEnd = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination justify-content-center flex-wrap">

            <li class="page-item @(Model.HasPrevious ? string.Empty : "disabled")">
                @if (Model.HasPrevious)
                {
                    <a class="page-link" href="@PageUrl(Model.CurrentPage - 1)" rel="prev">&laquo; Anterior</a>
                }
                else
                {
                    <span class="page-link">&laquo; Anterior</span>
                }
            </li>

            @if (windowStart > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@PageUrl(1)">1</a>
                </li>
                @if (windowStart > 2)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
            }

            @for (var i = windowStart; i <= windowEnd; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : string.Empty)">
                    @if (i == Model.CurrentPage)
                    {
                        <span class="page-link" aria-current="page">@i</span>
                    }
                    else
                    {
                        <a class="page-link" href="@PageUrl(i)">@i</a>
                    }
                </li>
            }

            @if (windowEnd < Model.TotalPages)
            {
                @if (windowEnd < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                <li class="page-item">
                    <a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a>
                </li>
            }

            <li class="page-item @(Model.HasNext ? string.Empty : "disabled")">
                @if (Model.HasNext)
                {
                    <a class="page-link" href="@PageUrl(Model.CurrentPage + 1)" rel="next">Siguiente &raquo;</a>
                }
                else
                {
                    <span class="page-link">Siguiente &raquo;</span>
                }
            </li>
        </ul>
    </nav>
}
