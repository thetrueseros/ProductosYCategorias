@model ProductosYCategorias.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var isNotFound = Model.StatusCode == 404;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card text-center">
            <div class="card-body py-5">
                <p class="display-4 fw-semibold mb-1 @(isNotFound ? "text-warning" : "text-danger")">
                    @Model.StatusCode
                </p>
                <h1 class="h3 mb-3">
                    @(isNotFound ? "Página no encontrada" : "Algo ha ido mal")
                </h1>
                <p class="text-muted mb-4">
                    @(Model.Message ?? "Ha ocurrido un error inesperado. Inténtalo de nuevo.")
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Ver productos</a>
                </div>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mt-4 mb-0">
                        Identificador de la solicitud: <code>@Model.RequestId</code>
                    </p>
                }
            </div>
        </div>
    </div>
</div>
