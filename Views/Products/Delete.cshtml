@model ProductosYCategorias.Models.Product

@{
    ViewData["Title"] = "Eliminar producto";
}

<nav aria-label="migas de pan" class="mb-2">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Productos</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></li>
        <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
    </ol>
</nav>

<h1 class="mb-3">Eliminar producto</h1>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card border-danger">
            <div class="card-body">
                <h2 class="h5">¿Seguro que quieres eliminar «@Model.Name»?</h2>
                <p class="text-muted">Esta acción no se puede deshacer.</p>

                <dl class="row mb-0">
                    <dt class="col-sm-3">Nombre</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Precio (COP)</dt>
                    <dd class="col-sm-9">@Model.Price.ToString("C2")</dd>

                    <dt class="col-sm-3">Stock</dt>
                    <dd class="col-sm-9">@Model.Stock unidad(es)</dd>

                    <dt class="col-sm-3">Categoría</dt>
                    <dd class="col-sm-9">@(Model.Category?.Name ?? "—")</dd>

                    <dt class="col-sm-3">Fecha de creación</dt>
                    <dd class="col-sm-9">@ColombiaTime.FromUtc(Model.FechaCreacion).ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>

            <div class="card-footer bg-white">
                <form asp-action="Delete" class="d-flex flex-wrap gap-2">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
