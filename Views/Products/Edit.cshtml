@model ProductosYCategorias.Models.Product

@{
    ViewData["Title"] = "Editar producto";
}

<h1>Editar producto</h1>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        <form asp-action="Edit" class="card card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autocomplete="off" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="text" inputmode="decimal" autocomplete="off" />
                <div class="form-text">Puedes usar coma o punto como separador decimal (1299,99 o 1299.99).</div>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Stock" class="form-label"></label>
                <input asp-for="Stock" class="form-control" type="number" min="0" step="1" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                    <option value="">Selecciona una categoría...</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Fecha de creación</label>
                <input class="form-control" value="@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")" disabled />
                <div class="form-text">La fecha de creación no se puede modificar.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
